# Copy to /var/www/projectrack/.env and chmod 640.
# Owner root, group www-data. Do not commit the filled-in file.
# This file is one directory above public/, so Apache does not serve it.

APP_NAME=ProjectRack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Current VPS has no hostname. Use the public origin, including the port.
# When a domain is on HTTPS, switch this to https://YOUR_DNS_NAME with no port.
APP_URL=http://185.206.147.145:8088

# Trust X-Forwarded-* only from the local web server. Do not set this to *.
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=projectrack
DB_USERNAME=projectrack
DB_PASSWORD=

SESSION_DRIVER=database
# false while the site is plain HTTP. Set true only after HTTPS is on.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=185.206.147.145
