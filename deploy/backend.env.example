# Copy to /var/www/projectrack/.env and chmod 640.
# Owner root, group www-data. Do not commit the filled-in file.
# This file is one directory above public/, so Apache does not serve it.

APP_NAME=ProjectRack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DNS_NAME

# Apache on this VPS terminates HTTPS. Leave this as the local PHP-FPM peer.
# Do not set it to *.
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=projectrack
DB_USERNAME=projectrack
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=YOUR_DNS_NAME
